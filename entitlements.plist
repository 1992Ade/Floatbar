<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ======================================================================
         2.0.4: entitlement set REDUCED to the known-working Andromeda
         baseline. Our 2.0.0-2.0.3 set carried ~9 extra keys (keychain group
         "apple", QuartzCore.*, cs.allow-jit, cs.allow-unsigned-executable-
         memory, exception.mach-lookup.global-name, wifi.manager-access,
         itunesstored.private, mobileinstall.allowedSPI). Diagnostic on the
         user's SE1 / 15.8.8 showed setuid(0)=EPERM and rootSpawn=exit -1,
         meaning TrollStore refused to apply CS_PLATFORM_BINARY. The most
         likely cause is one of those extras being on TrollStore's
         deny-list.

         This file is a verbatim copy of Andromeda's entitlements.plist
         minus the application-groups / icloud-container-identifiers keys
         (those are specific to Andromeda's Bookmark share extension).
         Once this build confirms rootSpawn works, the per-section extras
         will be re-added one at a time to identify which one trips
         TrollStore.
         ====================================================================== -->

    <!-- Core TrollStore — platformisation triplet.
         ResolutionSetterSwift (haoict) ships ONLY these three keys and
         they are sufficient for setuid(0) and persona_np. Everything
         else below is additional access, not platformisation. -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.persona-mgmt</key>
    <true/>

    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.container-manager</key>
    <true/>
    <key>com.apple.private.security.system-application</key>
    <true/>

    <!-- IOKit user clients — same array Andromeda ships. Needed for
         IOSurface allocations the ClearShot capture path uses. -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>IOHDIXControllerUserClient</string>
        <string>IOSurfaceRootUserClient</string>
    </array>

    <!-- Sandbox file exception on the whole filesystem — Andromeda's
         pattern. This is a sandbox exception, not UNIX-level grant;
         rootSpawn still handles the root-owned paths. -->
    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/</string>
    </array>

    <!-- LocSim — lets CLSimulationManager drive fake coordinates. -->
    <key>com.apple.locationd.simulation</key>
    <true/>

    <!-- Supervise — SystemConfiguration + MobileContainerManager writes
         needed to flip IsSupervised in the shared SystemGroup plist. -->
    <key>com.apple.SystemConfiguration.SCDynamicStore-write-access</key>
    <true/>
    <key>com.apple.private.MobileContainerManager.allowed</key>
    <true/>
    <key>com.apple.private.MobileInstallationHelperService.InstallDaemonOpsEnabled</key>
    <true/>
    <key>com.apple.private.MobileInstallationHelperService.allowed</key>
    <true/>
    <key>com.apple.private.uninstall.deletion</key>
    <true/>
    <key>com.apple.private.security.storage.MobileDocuments</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.managedconfiguration.profiled-access</key>
    <true/>
    <key>com.apple.mobile.deleted.AllowFreeSpace</key>
    <true/>
    <key>com.apple.private.coreservices.canmaplsdatabase</key>
    <true/>
    <key>com.apple.lsapplicationworkspace.rebuildappdatabases</key>
    <true/>
    <key>com.apple.private.WebClips.read-write</key>
    <true/>

    <!-- ======================================================================
         REMOVED compared to 2.0.3, to isolate which one(s) trigger
         TrollStore's refusal of CS_PLATFORM_BINARY:

           com.apple.security.exception.mach-lookup.global-name
             (CARenderServer / backboard / frontboard mach lookups —
             ClearShot in-process capture will still resolve the symbol
             via dlopen, but mach port access from within our app may
             fail; needs re-test.)

           com.apple.QuartzCore.secure-mode
           com.apple.QuartzCore.screen-access
             (QuartzCore privileged access — likely the biggest blocker
             for ClearShot capture.)

           keychain-access-groups: ["apple", "com.apple.wifi",
                                     "com.apple.identities",
                                     "com.apple.certificates"]
             (Primary suspect — claiming Apple's own keychain groups
             is almost certainly on TrollStore's deny-list.)

           com.apple.wifi.manager-access
             (Saved WiFi reveal — won't work until this is re-added.)

           com.apple.private.mobileinstall.allowedSPI
             (Array with UninstallForLaunchServices / SetCapabilities /
             Lookup — AppRepack SKUI* path may still work without it
             since those are StoreKit UI, not mobile-install SPIs.)

           com.apple.itunesstored.private
             (AppRepack Store purchase — needed for versioned download,
             to be re-added if it passes TrollStore.)

           com.apple.security.cs.allow-jit
           com.apple.security.cs.allow-unsigned-executable-memory
             (macOS codesign exceptions that don't apply on iOS. Harmless
             but might trigger TrollStore's "unknown entitlement" check.)

         Sections affected until these come back:
           - Saved WiFi (reveal passwords): broken until keychain group is
             sorted — likely needs a different approach, not just the
             Apple group claim.
           - ClearShot in-process capture: CARenderServer symbol still
             resolves, mach port may still work — to verify after this
             build runs.
           - AppRepack Store path: itunesstored.private removed, should
             re-add once we know TrollStore accepts it.
         ====================================================================== -->
</dict>
</plist>
