<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>TrollBox</string>
    <key>CFBundleExecutable</key>
    <string>ClearShot</string>
    <key>CFBundleIdentifier</key>
    <string>com.rockylabs.clearshot</string>
    <key>CFBundleName</key>
    <string>TrollBox</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.2</string>
    <key>CFBundleVersion</key>
    <string>4</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>iPhoneOS</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>14.0</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UILaunchStoryboardName</key>
    <string></string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>TrollBox's ClearShot section saves bypass screenshots to your Photos library.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>TrollBox's LocSim section uses this ONLY to re-center the map on your real current position when you tap the location button. Your position is never saved or sent anywhere. CLSimulationManager (what LocSim drives) runs from your pins; it doesn't need your real location to work.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>TrollBox's LocSim section uses this ONLY to re-center the map on your real current position when you tap the location button.</string>

    <!-- Files-app visibility: when the Ad Blocking install fallback drops a
         .mobileconfig into Documents/, these two flags make it visible under
         "On my iPhone → TrollBox" in Files. Without them, the user looked in
         Files after the fallback and found nothing. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- App icons at the root of the .app bundle (dropped there by after-stage). -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>icon-60</string>
                <string>icon-40</string>
                <string>icon-29</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>icon-60</string>
                <string>icon-76</string>
                <string>icon-83.5</string>
            </array>
        </dict>
    </dict>
</dict>
</plist>
